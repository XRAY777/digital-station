APP_ENV=development
LOG_LEVEL=INFO
# Local/offline demo defaults. Set STATION_HOST=0.0.0.0 for LAN access.
DATABASE_URL=sqlite:///./data/station.db
STATION_HOST=127.0.0.1
STATION_PORT=8000
STATION_BACKEND_URL=http://127.0.0.1:8000
STATION_ALLOWED_ORIGINS=
STATION_HISTORY_HOURS=48
AI_PROVIDER=none
POSTGRES_DB=station
POSTGRES_USER=station
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
STATION_HTTP_PORT=8080
# Optional OpenAI-compatible, Ollama, or LM Studio endpoint.
STATION_AI_BASE_URL=
STATION_AI_MODEL=local-model
# Set only for a configured external provider; never commit a real key.
STATION_AI_API_KEY=
